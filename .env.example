# Leave blank to use Pi's normal interactive/default model selection.
PI_PROVIDER=
PI_MODEL=

PI_HOST_PORT=9191
PI_CONTAINER_PORT=9191

PI_GIT_NAME=Pi Evolving Agent
PI_GIT_EMAIL=pi-evolving@local

# Resolved relative to this repository. Leave empty to disable agent evolution.
PI_AGENT_EVOLUTION_PATH=../pi-agent-evolution
PI_AGENT_AUTO_INSTALL=1

# Optional host directory mounted read-only into Pi. Configure both or neither.
PI_READONLY_HOST_PATH=
PI_READONLY_CONTAINER_PATH=

PI_IMAGE=pi-evolving:local
