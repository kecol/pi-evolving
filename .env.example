# Leave blank to use Pi's normal interactive/default model selection.
PI_PROVIDER=
PI_MODEL=

PI_HOST_PORT=9191
PI_CONTAINER_PORT=9191

PI_GIT_NAME=Pi Evolving Agent
PI_GIT_EMAIL=pi-evolving@local

# Optional version-controlled Pi capabilities repository. Use an absolute host path.
PI_AGENT_EVOLUTION_PATH=
PI_AGENT_AUTO_INSTALL=1

PI_IMAGE=pi-evolving:local
