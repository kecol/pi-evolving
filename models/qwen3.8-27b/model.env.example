# Qwen3.8-27B llama.cpp profile using the Unsloth UD-Q4_K_XL GGUF.
#
# Override LOCAL_MODELS_ROOT before sourcing this file when large models live
# on another disk. For example, under WSL2:
#   export LOCAL_MODELS_ROOT=/mnt/e/models

export LOCAL_MODELS_ROOT="${LOCAL_MODELS_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/llama.cpp/models}"
export HF_MODEL_REPO="unsloth/Qwen3.8-27B-GGUF"
export MODEL_QUANT="UD-Q4_K_XL"
export MODEL_DIR="$LOCAL_MODELS_ROOT/$HF_MODEL_REPO"
export MODEL_FILE="$MODEL_DIR/Qwen3.8-27B-$MODEL_QUANT.gguf"

# Native llama-server environment variables.
export LLAMA_ARG_MODEL="$MODEL_FILE"
export LLAMA_ARG_ALIAS="local-coder"
export LLAMA_ARG_HOST="0.0.0.0"
export LLAMA_ARG_PORT="8080"
export LLAMA_ARG_DEVICE="CUDA0"
export LLAMA_ARG_N_GPU_LAYERS="all"
export LLAMA_ARG_CTX_SIZE="73728"
export LLAMA_ARG_FLASH_ATTN="on"
export LLAMA_ARG_N_PARALLEL="1"
export LLAMA_ARG_SPEC_TYPE="draft-mtp"
export LLAMA_ARG_SPEC_DRAFT_N_MAX="2"
export LLAMA_ARG_CACHE_TYPE_K="q4_0"
export LLAMA_ARG_CACHE_TYPE_V="q4_0"
export LLAMA_ARG_JINJA="true"
export LLAMA_API_KEY="local-dev-key"

# llama-server does not currently expose environment variables for every
# sampler default. The serve script expands these variables as command flags.
export LOCAL_MODEL_TEMPERATURE="1.0"
export LOCAL_MODEL_TOP_P="0.95"
export LOCAL_MODEL_TOP_K="20"
export LOCAL_MODEL_MIN_P="0"
